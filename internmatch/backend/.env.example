# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is git-ignored — never commit real keys.

# MongoDB Atlas → Connect → Drivers → copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster. If teammates share one cluster, give each person their own
# (e.g. internmatch_illia) so nobody overwrites anyone else's embeddings. Default: internmatch
MONGODB_DB=internmatch

# Not used any more: embeddings run locally with sentence-transformers (all-MiniLM-L6-v2).
VOYAGE_API_KEY=

# Optional — only used for the one-line "why this matched" reasons.
# Leave empty and matching still works (reasons are just blank).
ANTHROPIC_API_KEY=

# Matching: keep results with vectorSearchScore >= MATCH_THRESHOLD (0–1, cosine).
# Tuned for all-MiniLM-L6-v2 on our listings.
MATCH_THRESHOLD=0.73
# Never send more than this many emails per CV upload.
MAX_EMAILS=5

# Gmail SMTP. Leave both empty to run in MOCK mode (emails are printed to the console instead).
# App password: Google Account → Security → 2-Step Verification → App passwords.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Comma-separated list of allowed frontend origins ("*" = allow all; fine for a local demo).
CORS_ORIGINS=*
